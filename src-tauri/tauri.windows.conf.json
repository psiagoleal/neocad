{
	"bundle": {
		"targets": ["nsis"],
		"fileAssociations": [
			{
				"ext": ["dwg"],
				"name": "NeoCAD DWG Drawing",
				"description": "Abrir desenhos DWG com NeoCAD",
				"role": "Editor"
			},
			{
				"ext": ["dxf"],
				"name": "NeoCAD DXF Drawing",
				"description": "Abrir desenhos DXF com NeoCAD",
				"role": "Editor"
			}
		],
		"windows": {
			"webviewInstallMode": {
				"type": "embedBootstrapper",
				"silent": true
			},
			"nsis": {
				"installMode": "currentUser",
				"displayLanguageSelector": true
			}
		}
	}
}
